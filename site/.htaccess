# ===========================================================================
# Apache configuration for researchlabusa.com (SiteGround)
# ---------------------------------------------------------------------------
# Copied to the web root on deploy. Everything here is optional tuning — the
# site works without it, so if something misbehaves, comment a block out
# rather than debugging blind.
# ===========================================================================

ErrorDocument 404 /404.html

# --- Canonical hostname ----------------------------------------------------
# Search engines were finding this site as both researchlabusa.com and
# www.researchlabusa.com, which splits each page into two addresses and
# divides whatever authority it has earned between them.
#
# researchlabusa.com is the canonical host. Both conditions are joined with
# [OR] so http://www.… reaches https://… in ONE hop: chained rules would send
# it via http:// first, and every extra hop costs a round trip and a little
# ranking signal.
#
# The HTTPS test accepts X-Forwarded-Proto as well as %{HTTPS}. Behind a proxy
# or CDN that terminates TLS upstream, %{HTTPS} is "off" even for a request
# that arrived over HTTPS — a rule testing only %{HTTPS} would then redirect
# an HTTPS request to HTTPS, for ever. That is the classic way this block
# takes a site down, and the second condition is what prevents it.
#
# If a redirect loop ever does appear, comment this block out first: the site
# serves correctly without it, and only the duplicate-hostname issue returns.
<IfModule mod_rewrite.c>
	RewriteEngine On

	# Anything not already on the canonical https://researchlabusa.com
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP:X-Forwarded-Proto} !=https [NC]
	RewriteRule ^ https://researchlabusa.com%{REQUEST_URI} [R=301,L,NE]

	RewriteCond %{HTTP_HOST} ^www\. [NC]
	RewriteRule ^ https://researchlabusa.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# --- Clean URLs ------------------------------------------------------------
# Every page is a directory index, so /about/ resolves to about/index.html and
# /contact/ to contact/index.php with no rewriting at all. Listing index.php
# here is what makes the contact page work: it is the one page without an
# index.html beside it.
DirectoryIndex index.html index.php

# The rules below only redirect the older extension URLs, which were live and
# may be linked or indexed. Routing does not depend on them: if mod_rewrite
# were unavailable the site still serves correctly, and only old links 404.
<IfModule mod_rewrite.c>
	RewriteEngine On

	# /index.html -> /
	RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
	RewriteRule ^ / [R=301,L]

	# /about.html -> /about/   (POST is excluded: a 301 would turn a form
	# submission into a GET and silently discard it. 404.html is excluded
	# because there is no /404/ directory to redirect it to.)
	RewriteCond %{REQUEST_METHOD} !=POST
	RewriteCond %{THE_REQUEST} !\s/+404\.html[\s?] [NC]
	RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
	RewriteRule ^ /%1/ [R=301,L,NE]

	# /contact.php -> /contact/
	RewriteCond %{REQUEST_METHOD} !=POST
	RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
	RewriteRule ^ /%1/ [R=301,L,NE]
</IfModule>

# --- Compression -----------------------------------------------------------
# Text assets compress by roughly 70%, the biggest single win for page weight.
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
	AddOutputFilterByType DEFLATE application/javascript application/x-javascript
	AddOutputFilterByType DEFLATE application/json application/xml
	AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Caching ---------------------------------------------------------------
# CSS and JS are requested with a ?v= hash of their contents, so editing
# either produces a new URL and the change is picked up immediately. That
# makes a long cache safe for them.
#
# Images are still replaced in place under the same filename, so they get one
# day — long enough to avoid a re-download on every page view, short enough
# that a replacement is not stranded for weeks. Give them the same ?v=
# treatment and this can be raised too.
#
# HTML must stay uncached or visitors keep seeing the previous version of a
# page after a deploy.
<IfModule mod_expires.c>
	ExpiresActive On

	ExpiresByType text/html              "access plus 0 seconds"
	ExpiresByType application/xml        "access plus 0 seconds"

	ExpiresByType text/css               "access plus 1 year"
	ExpiresByType application/javascript "access plus 1 year"

	ExpiresByType image/jpeg             "access plus 1 day"
	ExpiresByType image/png              "access plus 1 day"
	ExpiresByType image/webp             "access plus 1 day"
	ExpiresByType image/svg+xml          "access plus 7 days"
	ExpiresByType font/woff2             "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
	# Revalidate HTML on every request rather than serving it from cache.
	<FilesMatch "\.html$">
		Header set Cache-Control "no-cache, must-revalidate"
	</FilesMatch>

	# Stop browsers guessing a file's type from its contents.
	Header always set X-Content-Type-Options "nosniff"
	# Don't leak full URLs to other sites in the Referer header.
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	# A static site has no need for these device APIs.
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- HTTPS redirect --------------------------------------------------------
# Handled by the canonical-hostname block at the top of this file, which
# normalises scheme and host together in a single redirect. SiteGround may
# also enforce HTTPS in Site Tools (Security -> HTTPS Enforce); the two are
# harmless together, because whichever fires first lands on the canonical URL
# and the other then has nothing left to change.
