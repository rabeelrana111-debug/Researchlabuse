---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
	title="Page not found"
	description="The page you were looking for does not exist."
>
	<section class="rl-section">
		<div class="rl-container rl-measure">
			<p class="rl-eyebrow">Error 404</p>
			<h1>We couldn&rsquo;t find that page</h1>
			<p class="rl-lede">
				The link may be out of date, or the page may have moved.
			</p>
			<div class="rl-btn-row rl-mt-8">
				<a class="rl-btn rl-btn--primary" href="/">Go to the homepage</a>
				<a class="rl-btn rl-btn--secondary" href="/blog/">Browse the blog</a>
			</div>
		</div>
	</section>
</BaseLayout>
