---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
	title="Contact"
	description="Get in touch with Research Lab USA — questions, corrections and article suggestions are all welcome."
>
	<section class="rl-section rl-section--tight">
		<div class="rl-container">
			<div class="rl-section-head">
				<p class="rl-eyebrow">Contact</p>
				<h1>Get in touch</h1>
				<p class="rl-lede">
					Questions, corrections and suggestions for articles are all welcome.
					We usually reply within one business day.
				</p>
			</div>

			<div class="rl-measure">
				<div class="rl-notice rl-mb-0" style="margin-bottom: 2rem;">
					<strong>Before this form works:</strong> a static site cannot process
					form submissions on its own. Point the <code>action</code> below at a
					form service such as Formspree, Web3Forms or Basin, or delete the
					form and use the email link instead. See <code>docs/SITE-GUIDE.md</code>.
				</div>

				<form action="https://formspree.io/f/REPLACE_WITH_YOUR_FORM_ID" method="POST">
					<div class="rl-field">
						<label class="rl-label" for="name">Your name</label>
						<input class="rl-input" type="text" id="name" name="name" required />
					</div>
					<div class="rl-field">
						<label class="rl-label" for="email">Email address</label>
						<input class="rl-input" type="email" id="email" name="email" required />
					</div>
					<div class="rl-field">
						<label class="rl-label" for="message">Message</label>
						<textarea class="rl-textarea" id="message" name="message" required></textarea>
					</div>
					<button class="rl-btn rl-btn--primary" type="submit">Send message</button>
				</form>

				<h2 class="rl-mt-8">Other ways to reach us</h2>
				<p>
					Email <a href="mailto:hello@researchlabusa.com">hello@researchlabusa.com</a><br />
					Phone [PHONE NUMBER]<br />
					[STREET ADDRESS, CITY, STATE, ZIP]
				</p>
			</div>
		</div>
	</section>
</BaseLayout>
