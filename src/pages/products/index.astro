---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const products = (
	await getCollection('products', ({ data }) =>
		import.meta.env.PROD ? data.draft !== true : true
	)
).sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name));

// Group by category so the catalogue stays navigable as it grows.
const categories = [...new Set(products.map((p) => p.data.category))];
---

<BaseLayout
	title="Catalogue"
	description="Research compounds supplied with batch-level certificates of analysis. For laboratory research use only."
>
	<section class="rl-section rl-section--tight">
		<div class="rl-container">
			<div class="rl-section-head">
				<p class="rl-eyebrow">Catalogue</p>
				<h1>Research compounds</h1>
				<p class="rl-lede">
					Every batch is tested by an independent laboratory and the certificate
					is published before you order. All materials are supplied strictly for
					laboratory research use.
				</p>
			</div>

			{products.length === 0 ? (
				<p>No products are listed yet.</p>
			) : (
				categories.map((category) => (
					<div style="margin-bottom: 4rem;">
						<h2>{category}</h2>
						<div class="rl-grid rl-grid--posts">
							{products
								.filter((p) => p.data.category === category)
								.map((product) => (
									<article class="rl-card">
										<div class="rl-badge-row">
											<span class="rl-badge rl-badge--verified">
												{product.data.purity} HPLC
											</span>
											{!product.data.inStock && (
												<span class="rl-badge rl-badge--out">Out of stock</span>
											)}
										</div>
										<h3 class="rl-card__title">
											<a href={`/products/${product.id}/`}>{product.data.name}</a>
										</h3>
										<p class="rl-card__meta">
											{product.data.quantity} &middot; {product.data.format}
										</p>
										<p class="rl-card__excerpt">{product.data.description}</p>
										{product.data.price !== undefined && (
											<p class="rl-card__price">
												${product.data.price.toFixed(2)}
											</p>
										)}
										<a class="rl-card__more" href={`/products/${product.id}/`}>
											View specifications &rarr;
										</a>
									</article>
								))}
						</div>
					</div>
				))
			)}

			<div class="rl-notice rl-measure">
				<strong>For laboratory research use only.</strong> The materials listed
				here are not medicines, dietary supplements, cosmetics or food. None has
				been approved by the FDA for human or veterinary use, and none may be
				consumed by humans or animals.
			</div>
		</div>
	</section>
</BaseLayout>
