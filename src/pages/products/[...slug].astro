---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const products = await getCollection('products', ({ data }) =>
		import.meta.env.PROD ? data.draft !== true : true
	);
	return products.map((product) => ({
		params: { slug: product.id },
		props: { product },
	}));
}

const { product } = Astro.props;
const { Content } = await render(product);
const d = product.data;

// Only render specification rows that actually have a value, so a partly
// filled-in product doesn't show a table full of blanks.
const specs = [
	['Product name', d.name],
	['CAS number', d.cas],
	['Molecular formula', d.formula],
	['Molecular weight', d.molecularWeight],
	['Purity', d.purity],
	['Batch number', d.batch],
	['Format', d.format],
	['Quantity', d.quantity],
	['Storage', d.storage],
].filter(([, value]) => value);
---

<BaseLayout title={d.name} description={d.description}>
	<section class="rl-section rl-section--tight">
		<div class="rl-container">
			<p class="rl-eyebrow">
				<a href="/products/">Catalogue</a> / {d.category}
			</p>

			<div class="rl-product">
				<!-- Left column: specifications and description -->
				<div>
					<h1>{d.name}</h1>
					<div class="rl-badge-row">
						<span class="rl-badge rl-badge--verified">{d.purity} HPLC verified</span>
						{d.batch && <span class="rl-badge">Batch {d.batch}</span>}
						{d.inStock
							? <span class="rl-badge rl-badge--verified">In stock</span>
							: <span class="rl-badge rl-badge--out">Out of stock</span>}
					</div>

					<p class="rl-lede">{d.description}</p>

					<h2>Specifications</h2>
					<div class="rl-table-scroll">
						<table class="rl-spec-table">
							<tbody>
								{specs.map(([label, value]) => (
									<tr>
										<th scope="row">{label}</th>
										<td>{value}</td>
									</tr>
								))}
								{d.coaUrl && (
									<tr>
										<th scope="row">Certificate of analysis</th>
										<td><a href={d.coaUrl}>Download PDF</a></td>
									</tr>
								)}
							</tbody>
						</table>
					</div>

					<div class="rl-prose" style="margin-top: 3rem;">
						<Content />
					</div>

					<h2 style="margin-top: 3rem;">Analysis and verification</h2>
					<p>
						This batch was tested by an independent analytical laboratory using
						HPLC. The certificate states the batch number, test date and
						measured purity. Confirm that the batch number on the certificate
						matches the number printed on the label you receive.
					</p>

					<h2>Handling and storage</h2>
					<p>
						{d.storage} Handle in an appropriate laboratory setting using
						suitable personal protective equipment, and consult the safety data
						sheet before use.
					</p>

					<div class="rl-notice" style="margin-top: 2rem;">
						<strong>For laboratory research use only.</strong> This product is
						not a medicine, dietary supplement or food. It has not been
						approved by the FDA for human or veterinary use, is not intended to
						diagnose, treat, cure or prevent any disease, and must not be
						consumed by humans or animals. By purchasing you confirm you are a
						qualified professional using it for legitimate research.
					</div>
				</div>

				<!-- Right column: purchase panel -->
				<aside class="rl-product__buy">
					{d.price !== undefined && (
						<p class="rl-product__price">${d.price.toFixed(2)}</p>
					)}
					<p class="rl-card__meta">{d.quantity} &middot; {d.format}</p>

					{d.inStock ? (
						<a class="rl-btn rl-btn--primary" href="/contact/" style="width: 100%;">
							Enquire about this product
						</a>
					) : (
						<button class="rl-btn rl-btn--secondary" style="width: 100%;" disabled>
							Currently unavailable
						</button>
					)}

					{d.coaUrl && (
						<a class="rl-btn rl-btn--secondary" href={d.coaUrl} style="width: 100%; margin-top: 0.75rem;">
							View certificate of analysis
						</a>
					)}

					<ul class="rl-footer__list" style="margin-top: 1.5rem; font-size: 0.9375rem; color: var(--rl-muted);">
						<li>Independent third-party testing</li>
						<li>Batch-level traceability</li>
						<li>Dispatched from [STATE]</li>
					</ul>
				</aside>
			</div>
		</div>
	</section>
</BaseLayout>
