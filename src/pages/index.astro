---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const products = (
	await getCollection('products', ({ data }) =>
		import.meta.env.PROD ? data.draft !== true : true
	)
)
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 3);

const recentPosts = (
	await getCollection('blog', ({ data }) =>
		import.meta.env.PROD ? data.draft !== true : true
	)
)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<BaseLayout
	title="Research Lab USA"
	description="Research compounds supplied with independent third-party testing and a published certificate of analysis for every batch. For laboratory research use only."
>
	<!-- Hero -->
	<section class="rl-section">
		<div class="rl-container">
			<div class="rl-measure">
				<p class="rl-eyebrow">Third-party tested research compounds</p>
				<h1>Research compounds you can actually verify</h1>
				<p class="rl-lede">
					Every batch we ship is tested by an independent laboratory, and every
					result is published. Check the certificate of analysis before you
					order — not after.
				</p>
				<div class="rl-btn-row rl-mt-8">
					<a class="rl-btn rl-btn--primary" href="/products/">Browse the catalogue</a>
					<a class="rl-btn rl-btn--secondary" href="/about/">How we test</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Trust bar -->
	<div class="rl-container">
		<ul class="rl-trustbar">
			<li>Independent third-party testing</li>
			<li>COA on every batch</li>
			<li>Same-day dispatch before [3 PM EST]</li>
			<li>Tracked shipping</li>
		</ul>
	</div>

	<!-- Why us -->
	<section class="rl-section">
		<div class="rl-container">
			<div class="rl-section-head">
				<p class="rl-eyebrow">Why researchers choose us</p>
				<h2>Built for people who check the paperwork</h2>
				<p class="rl-lede">
					Reproducible research depends on knowing exactly what is in the vial.
					We structure the whole operation around making that verifiable rather
					than asking you to take our word for it.
				</p>
			</div>
			<div class="rl-grid rl-grid--features">
				<article class="rl-card">
					<div class="rl-feature__icon" aria-hidden="true">01</div>
					<h3 class="rl-card__title">Analysis you can read</h3>
					<p class="rl-mb-0">
						Every batch goes to an independent lab for HPLC purity testing, and
						the full certificate is linked on the product page — matched to the
						batch number printed on your label.
					</p>
				</article>
				<article class="rl-card">
					<div class="rl-feature__icon" aria-hidden="true">02</div>
					<h3 class="rl-card__title">Batch-level traceability</h3>
					<p class="rl-mb-0">
						Nothing is pooled, relabelled or substituted between batches, so
						the analysis you reviewed is the analysis of what you received.
					</p>
				</article>
				<article class="rl-card">
					<div class="rl-feature__icon" aria-hidden="true">03</div>
					<h3 class="rl-card__title">Controlled handling</h3>
					<p class="rl-mb-0">
						Materials are stored under controlled conditions and prepared in a
						clean environment, so what leaves our facility matches the
						specification on file.
					</p>
				</article>
				<article class="rl-card">
					<div class="rl-feature__icon" aria-hidden="true">04</div>
					<h3 class="rl-card__title">Straight answers</h3>
					<p class="rl-mb-0">
						Technical questions go to someone who can answer them. If we do not
						know, we say so rather than guessing.
					</p>
				</article>
			</div>
		</div>
	</section>

	<!-- Featured products -->
	<section class="rl-section rl-section--alt">
		<div class="rl-container">
			<div class="rl-section-head">
				<p class="rl-eyebrow">Catalogue</p>
				<h2>Available now</h2>
			</div>

			{products.length === 0 ? (
				<p>No products are listed yet.</p>
			) : (
				<div class="rl-grid rl-grid--posts">
					{products.map((product) => (
						<article class="rl-card">
							<div class="rl-badge-row">
								<span class="rl-badge rl-badge--verified">
									{product.data.purity} HPLC
								</span>
							</div>
							<h3 class="rl-card__title">
								<a href={`/products/${product.id}/`}>{product.data.name}</a>
							</h3>
							<p class="rl-card__meta">
								{product.data.quantity} &middot; {product.data.format}
							</p>
							<p class="rl-card__excerpt">{product.data.description}</p>
							<a class="rl-card__more" href={`/products/${product.id}/`}>
								View specifications &rarr;
							</a>
						</article>
					))}
				</div>
			)}

			<div class="rl-mt-8">
				<a class="rl-btn rl-btn--secondary" href="/products/">View full catalogue</a>
			</div>
		</div>
	</section>

	<!-- Testing explainer -->
	<section class="rl-section">
		<div class="rl-container rl-measure">
			<p class="rl-eyebrow">Quality assurance</p>
			<h2>What third-party testing actually means here</h2>
			<p>
				&ldquo;Tested&rdquo; gets used loosely in this industry. For us it means
				a sample from the batch you are buying goes to an independent analytical
				laboratory with no commercial interest in the result. That laboratory
				runs HPLC analysis to confirm identity and quantify purity, and issues a
				signed certificate.
			</p>
			<p>
				We publish those certificates in full — batch number, test date, measured
				purity — rather than a summary or a figure typed onto a graphic. If a
				batch does not meet specification, it does not go on sale.
			</p>
		</div>
	</section>

	<!-- Recent writing -->
	{recentPosts.length > 0 && (
		<section class="rl-section rl-section--alt">
			<div class="rl-container">
				<div class="rl-section-head">
					<p class="rl-eyebrow">From the blog</p>
					<h2>Recent articles</h2>
				</div>
				<div class="rl-grid rl-grid--posts">
					{recentPosts.map((post) => (
						<PostCard
							url={`/blog/${post.id}/`}
							title={post.data.title}
							description={post.data.description}
							pubDate={post.data.pubDate}
							tags={post.data.tags}
						/>
					))}
				</div>
			</div>
		</section>
	)}

	<!-- Compliance -->
	<section class="rl-section rl-section--dark">
		<div class="rl-container rl-measure">
			<h2>Terms of sale, stated plainly</h2>
			<p>
				All materials sold on this website are intended exclusively for
				laboratory research conducted by qualified professionals. They are not
				medicines, dietary supplements, cosmetics or food, and none has been
				evaluated or approved for human or veterinary use by the FDA or any
				comparable authority.
			</p>
			<p>
				Nothing here is medical advice or a suggestion that any product is safe
				or effective for any purpose. By ordering you confirm you are at least
				[18/21] years of age and will handle these materials in an appropriate
				research setting, in accordance with all laws that apply where you are.
			</p>
			<div class="rl-btn-row rl-mt-6">
				<a class="rl-btn rl-btn--primary" href="/products/">Browse the catalogue</a>
			</div>
		</div>
	</section>
</BaseLayout>
