---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	article?: boolean;
	publishedDate?: Date;
}
const { title, description, article, publishedDate } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			article={article}
			publishedDate={publishedDate}
		/>
	</head>
	<body>
		<a class="rl-skip" href="#main">Skip to content</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
