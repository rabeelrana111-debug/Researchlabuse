---
import FormattedDate from './FormattedDate.astro';

interface Props {
	url: string;
	title: string;
	description: string;
	pubDate: Date;
	tags?: string[];
}
const { url, title, description, pubDate, tags = [] } = Astro.props;
---
<article class="rl-card">
	<h3 class="rl-card__title"><a href={url}>{title}</a></h3>
	<p class="rl-card__meta"><FormattedDate date={pubDate} /></p>
	<p class="rl-card__excerpt">{description}</p>
	{tags.length > 0 && (
		<ul class="rl-tags" style="margin-bottom: 1rem;">
			{tags.slice(0, 3).map((tag) => <li class="rl-tag">{tag}</li>)}
		</ul>
	)}
	<a class="rl-card__more" href={url}>Read article &rarr;</a>
</article>
