---
/**
 * Site header. Marks the active link with aria-current so it is announced by
 * screen readers as well as styled.
 */
const links = [
	{ href: '/', label: 'Home' },
	{ href: '/blog/', label: 'Blog' },
	{ href: '/about/', label: 'About' },
	{ href: '/contact/', label: 'Contact' },
];

// Normalise to a trailing slash so "/blog" and "/blog/" both match.
const path = Astro.url.pathname.replace(/\/?$/, '/');

const isActive = (href: string) =>
	href === '/' ? path === '/' : path.startsWith(href);
---
<header class="rl-header">
	<div class="rl-container rl-header__inner">
		<a class="rl-logo" href="/">
			<span class="rl-logo__mark" aria-hidden="true">◆</span>
			Research Lab USA
		</a>
		<nav class="rl-nav" aria-label="Main">
			{links.map((link) => (
				<a
					href={link.href}
					aria-current={isActive(link.href) ? 'page' : undefined}
				>
					{link.label}
				</a>
			))}
		</nav>
	</div>
</header>
